+/// For every `FOO_FILE` env var, reads the file it points at and sets `FOO`
+/// to its contents (trailing newline stripped). An already-set `FOO` wins.
+fn expand_file_env_vars() {
+    for (key, path) in std::env::vars().collect::<Vec<_>>() {
+        let Some(target) = key.strip_suffix("_FILE") else {
+            continue;
+        };
+        if target.is_empty() || std::env::var_os(target).is_some() {
+            continue;
+        }
+        match std::fs::read_to_string(&path) {
+            Ok(value) => {
+                // SAFETY: Single-threaded startup, no other threads running.
+                unsafe { std::env::set_var(target, value.trim_end_matches(['\n', '\r'])) };
+            }
+            Err(err) => eprintln!("  Warning: could not read {key}={path}: {err}"),
+        }
+    }
