+// Returns absolute path after 'file:' prefix, or NULL if not a file: reference.
+// Sets *is_valid = false if it's a file: reference but path is not absolute.
+static const char *parse_file_ref(const char *s, bool *is_valid) {
+    if(strncmp(s, "file:", 5) != 0)
+        return NULL;
+    const char *path = s + 5;
+    while(*path && isspace((uint8_t)*path)) path++;
+    *is_valid = (*path == '/');
+    return path;
+}
